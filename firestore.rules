rules_version = '2';
// Ana Banana exercise plan (tobiasfk.github.io/ana-banana-exercise).
// Each person's plan lives under fitness/{uid}/docs/*, readable and writable only by them. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /fitness/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
  }
}
